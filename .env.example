# Frontend (Vite) — anon key ONLY. Never put the service-role key here.
# Fill these from `npm run sb:status` after `npm run sb:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Optional. Defaults to ${VITE_SUPABASE_URL}/functions/v1. Set this to a locally
# `deno run` function port (e.g. http://127.0.0.1:8000) when the edge_runtime
# container is unavailable.
# VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:8000
